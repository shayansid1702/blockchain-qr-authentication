# ============================================================
# blockchain/.env.example
# Copy this file to blockchain/.env and fill in real values.
# NEVER commit the actual .env file to Git.
# ============================================================

# RPC endpoint for the Sepolia testnet.
# Get a free one from Alchemy (https://alchemy.com) or Infura (https://infura.io).
# Example: https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
SEPOLIA_RPC_URL=

# Private key of a TEST-ONLY wallet used to deploy/interact with the contract
# on Sepolia. This wallet should hold ONLY testnet ETH — never your real wallet.
# Export it from MetaMask: Account menu -> Account details -> Show private key.
PRIVATE_KEY=

# Optional: Etherscan API key, only needed if you want to verify the
# contract source code on sepolia.etherscan.io via `hardhat verify`.
#ETHERSCAN_API_KEY=
