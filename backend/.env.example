# ============================================================
# backend/.env.example
# Copy to backend/.env and fill in real values. Never commit .env.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL (matches database/schema.sql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blockchain_qr_auth

# JWT
# Generate a strong random secret, e.g.: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=8h

# CORS: the frontend origin allowed to call this API
FRONTEND_ORIGIN=http://localhost:5173

# Blockchain read access (backend only ever READS from chain, it never
# holds a manufacturer's private key)
SEPOLIA_RPC_URL=
CONTRACT_ADDRESS=
